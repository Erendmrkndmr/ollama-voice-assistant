# -------- LLM / Ollama ----------
OLLAMA_URL=http://localhost:11434
LLM_MODEL=phi3:mini
NUM_PREDICT=128
TEMP=0.2
TOP_P=0.9
REPEAT_PENALTY=1.1
SEED=42

# -------- Whisper STT (Speech-to-Text) ----------
WHISPER_MODEL_PATH=./models/whisper/distil-large-v3
STT_LANG=en
STT_FORCE_LANG=True
STT_TASK=transcribe

# Decode tuning
STT_BEAM_SIZE=5
STT_TEMPERATURE=0.0
STT_TEMPERATURE_FALLBACKS=0.0,0.2
STT_NO_SPEECH_THRESH=0.6
STT_PATIENCE=1.0
STT_CONDITION_PREV=True

# -------- VAD (Voice Activity Detection) ----------
VAD_FRAME_MS=20
VAD_AGGRESSIVENESS=2
VAD_START_FRAMES=3
VAD_END_SIL_MS=700
VAD_MAX_SECONDS=45.0

# -------- Persona / Language ----------
PERSONA_TYPE=Customer Support
CUSTOM_DIRECTIVE=Keep answers friendly and brief.
PERSONA_DIR=./ollama/persona_prompts
ASSISTANT_LANG=en

# -------- TTS (Text-to-Speech) ----------
ASSISTANT_TTS=True
