# -------- LLM / Ollama ----------
OLLAMA_URL=http://localhost:11434
LLM_MODEL=phi3:mini
NUM_PREDICT=64
TEMP=0.2
TOP_P=0.9
REPEAT_PENALTY=1.1
SEED=42

# -------- Whisper STT ----------
# Lokal model yolu (offline kullanım)
WHISPER_MODEL_PATH=./models/whisper/base
STT_LANG=tr

# -------- VAD (konuşma algılama) ----------
VAD_FRAME_MS=20            # 10 | 20 | 30
VAD_AGGRESSIVENESS=2       # 0..3
VAD_START_FRAMES=3         # konuşma başlangıcı için ardışık speech frame sayısı
VAD_END_SIL_MS=600         # şu kadar sessizlikte bitir
VAD_MAX_SECONDS=30.0       # tek cümle üst limiti

# -------- Persona ----------
PERSONA_TYPE=Customer Support
CUSTOM_DIRECTIVE=Keep answers friendly and brief.
PERSONA_DIR=./ollama/persona_prompts
